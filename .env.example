# ==============================================================================
# KrishiConnect Root Environment Variables Reference
# ==============================================================================
# This file provides a centralized overview of environment configuration
# for both the Spring Boot Backend and the React Frontend.
# Copy or supply these variables when configuring local environments or deployments.

# ------------------------------------------------------------------------------
# 1. Spring Boot Backend Configuration (backend/src/main/resources/application.properties)
# ------------------------------------------------------------------------------
PORT=5001

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/krishiconnect?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars_1234567890
JWT_EXPIRATION_MS=604800000

# File Upload Directory
UPLOAD_PATH=uploads

# Initial Default Administrator Account Bootstrap
ADMIN_NAME=FHC Admin
ADMIN_EMAIL=admin@fhc.com
ADMIN_PASSWORD=your_admin_password

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Payment Gateway (Razorpay - Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# ------------------------------------------------------------------------------
# 2. React Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5001/api
VITE_WS_URL=http://localhost:5001/ws
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
